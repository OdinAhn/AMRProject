# 35단계: 컨테이너용 nginx 설정. ${BACKEND_URL}은 nginx 이미지가 기동 시 환경 변수로 치환한다.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # 실시간 이벤트(SSE): 버퍼링하면 이벤트가 모였다가 한꺼번에 도착하므로 끄고, 연결을 오래 유지한다
    location = /api/events/stream {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # actuator는 백엔드 관리 포트 전용이다 — SPA 대체 응답(index.html 200)으로 오해하지 않게 명시적으로 막는다
    location /actuator/ {
        return 404;
    }

    # 해시가 붙은 빌드 산출물은 오래 캐시하고, index.html은 매번 확인한다
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: 없는 경로는 index.html로 넘겨 React Router가 처리한다
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
