# 35단계: docker-compose.prod.yml용 환경 변수 예시. 복사해서 .env로 만들고 값을 채운다(.env는 커밋하지 않는다).
#   cp .env.example .env
# 비밀값은 충분히 긴 임의 문자열로 만든다. 예: openssl rand -base64 48

DB_USERNAME=amr
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 필수: 접근 토큰 서명 키. 바꾸면 발급된 토큰이 모두 무효가 된다.
TOKEN_SIGNING_SECRET=

# 외부 시스템 API(/api/external/**)용 X-API-Key. 비워 두면 외부 API는 전부 401이다.
EXTERNAL_API_KEY=

# 빈 데이터베이스 첫 기동 때만 관리자 계정을 만든다. 만든 뒤에는 지우고 재기동하는 것을 권장한다.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 실제 로봇(MQTT/VDA 5050) 연동. 기본은 시뮬레이터.
ROBOT_GATEWAY_MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://mosquitto:1883
# 명령 결과를 기다리는 최대 시간(초). 넘으면 작업 복구 필요
MQTT_COMMAND_TIMEOUT_SECONDS=300

# 화면(nginx)을 열 호스트 포트
HTTP_PORT=80
